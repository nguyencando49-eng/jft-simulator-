# Local development
AUTH_DISABLED=true

# Supabase production
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# V5 AI Question Factory
# mock = deterministic local provider, no key required
# http = provider-neutral external adapter
# azure-openai = native Azure OpenAI JSON adapter (requires a deployed model)
AI_FACTORY_PROVIDER=mock
AI_FACTORY_ENDPOINT=
AI_FACTORY_API_KEY=
AI_FACTORY_MODEL=
# Shared Azure OpenAI fallback values used when the scoped values above are empty.
AOAI_ENDPOINT=
API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# V5.1 semantic QA
AI_QA_PROVIDER=mock
AI_QA_ENDPOINT=
AI_QA_API_KEY=
AI_QA_MODEL=

# QA2 independent Answer Oracle
ANSWER_ORACLE_PROVIDER=mock
ANSWER_ORACLE_ENDPOINT=
ANSWER_ORACLE_API_KEY=
ANSWER_ORACLE_MODEL=
ANSWER_ORACLE_CONFIDENCE_THRESHOLD=0.85

# QA3 Japanese Naturalness Judge
JAPANESE_NATURALNESS_PROVIDER=mock
JAPANESE_NATURALNESS_ENDPOINT=
JAPANESE_NATURALNESS_API_KEY=
JAPANESE_NATURALNESS_MODEL=

# QA4 Curriculum Grounding Judge
CURRICULUM_GROUNDING_PROVIDER=mock
CURRICULUM_GROUNDING_ENDPOINT=
CURRICULUM_GROUNDING_API_KEY=
CURRICULUM_GROUNDING_MODEL=
# Complete catalogs up to this size are sent in full; larger searches become REVIEW-safe subsets.
CURRICULUM_GROUNDING_MAX_UNITS=100

# QA5 JFT Alignment Judge
JFT_ALIGNMENT_PROVIDER=mock
JFT_ALIGNMENT_ENDPOINT=
JFT_ALIGNMENT_API_KEY=
JFT_ALIGNMENT_MODEL=

# QA6 Difficulty Calibration Judge
DIFFICULTY_CALIBRATION_PROVIDER=mock
DIFFICULTY_CALIBRATION_ENDPOINT=
DIFFICULTY_CALIBRATION_API_KEY=
DIFFICULTY_CALIBRATION_MODEL=

# QA7 Originality & Duplicate Judge
ORIGINALITY_DUPLICATE_PROVIDER=mock
ORIGINALITY_DUPLICATE_ENDPOINT=
ORIGINALITY_DUPLICATE_API_KEY=
ORIGINALITY_DUPLICATE_MODEL=

# V5.1 TTS: mock creates a short WAV tone for end-to-end development only.
TTS_PROVIDER=mock
TTS_ENDPOINT=
TTS_API_KEY=
TTS_VOICE=
# Azure Japanese Speech (server-only; never use NEXT_PUBLIC_ for the key).
# TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=japaneast
AZURE_SPEECH_VOICE=ja-JP-NanamiNeural
AZURE_SPEECH_RATE=-5%
EXAM_ASSET_BUCKET=exam-assets
# Optional override when the storage bucket has a custom/public CDN base URL.
EXAM_ASSET_PUBLIC_BASE_URL=

# Browser E2E only. Never enable in production.
E2E_TEST_MODE=false
