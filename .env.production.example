# Production deployment template — never commit real secrets.
AUTH_DISABLED=false
E2E_TEST_MODE=false

# Durable application state + Auth
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
EXAM_ASSET_BUCKET=exam-assets
EXAM_ASSET_PUBLIC_BASE_URL=

# Question generation and independent semantic QA
AI_FACTORY_PROVIDER=azure-openai
AI_QA_PROVIDER=azure-openai
AOAI_ENDPOINT=
API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AI_REQUEST_TIMEOUT_MS=45000

# Specialized QA2–QA7 providers. Configure real HTTP adapters or equivalent production providers.
ANSWER_ORACLE_PROVIDER=http
ANSWER_ORACLE_ENDPOINT=
ANSWER_ORACLE_API_KEY=
ANSWER_ORACLE_MODEL=
ANSWER_ORACLE_CONFIDENCE_THRESHOLD=0.85

JAPANESE_NATURALNESS_PROVIDER=http
JAPANESE_NATURALNESS_ENDPOINT=
JAPANESE_NATURALNESS_API_KEY=
JAPANESE_NATURALNESS_MODEL=

CURRICULUM_GROUNDING_PROVIDER=http
CURRICULUM_GROUNDING_ENDPOINT=
CURRICULUM_GROUNDING_API_KEY=
CURRICULUM_GROUNDING_MODEL=
CURRICULUM_GROUNDING_MAX_UNITS=100

JFT_ALIGNMENT_PROVIDER=http
JFT_ALIGNMENT_ENDPOINT=
JFT_ALIGNMENT_API_KEY=
JFT_ALIGNMENT_MODEL=

DIFFICULTY_CALIBRATION_PROVIDER=http
DIFFICULTY_CALIBRATION_ENDPOINT=
DIFFICULTY_CALIBRATION_API_KEY=
DIFFICULTY_CALIBRATION_MODEL=

ORIGINALITY_DUPLICATE_PROVIDER=http
ORIGINALITY_DUPLICATE_ENDPOINT=
ORIGINALITY_DUPLICATE_API_KEY=
ORIGINALITY_DUPLICATE_MODEL=

# Listening generation
TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=japaneast
AZURE_SPEECH_VOICE=ja-JP-NanamiNeural
AZURE_SPEECH_RATE=-5%
TTS_REQUEST_TIMEOUT_MS=45000
STORAGE_REQUEST_TIMEOUT_MS=30000
