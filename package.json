    "generator:a1-recovery-pilot": "vite-node scripts/run-generator-recovery-a1-pilot.ts",
    "generator:a1-recovery-pilot-2": "vite-node scripts/run-generator-recovery-a1-pilot-2.ts",
    "generator:approve-a1-recovery-pilot-2": "vite-node scripts/record-generator-recovery-pilot-2-approval.ts",
    "generator:controlled-a1-batch-001": "vite-node scripts/run-controlled-a1-batch-001.ts",
    "generator:approve-controlled-a1-batch-001": "vite-node scripts/record-controlled-a1-batch-001-approval.ts",
